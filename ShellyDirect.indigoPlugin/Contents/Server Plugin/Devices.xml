<?xml version="1.0"?>
<Devices>

	<!-- ============================================================
	     shellyRelay
	     Single or multi-channel relay with optional power monitoring.
	     Covers: Plus Plug UK/S/IT/US, Shelly 1/1PM/Mini, Pro 1/1PM,
	             Gen 3/4 variants, individual channels of Plus 2PM / Pro 4PM.
	     ============================================================ -->
	<Device type="relay" id="shellyRelay">
		<Name>Shelly Relay</Name>
		<ConfigUI>
			<Field id="ip_address" type="textfield" defaultValue="">
				<Label>IP Address:</Label>
			</Field>
			<Field id="hlpIp" type="label" fontSize="mini" alignWithControl="true">
				<Label>Local IP address of the Shelly device (e.g. 192.168.1.10)</Label>
			</Field>
			<Field id="sep1" type="separator"/>
			<Field id="channel_id" type="menu" defaultValue="0">
				<Label>Channel:</Label>
				<List>
					<Option value="0">0 - Single channel or Ch 1</Option>
					<Option value="1">1 - Ch 2 (Plus 2PM / Pro 4PM)</Option>
					<Option value="2">2 - Ch 3 (Pro 4PM)</Option>
					<Option value="3">3 - Ch 4 (Pro 4PM)</Option>
				</List>
			</Field>
			<Field id="hlpChan" type="label" fontSize="mini" alignWithControl="true">
				<Label>Use 0 for single-channel devices. For Pro 4PM or Plus 2PM create one device per channel.</Label>
			</Field>
			<Field id="sep2" type="separator"/>
			<Field id="has_pm" type="checkbox" defaultValue="true">
				<Label>Has Power Monitoring (PM):</Label>
			</Field>
			<Field id="hlpPm" type="label" fontSize="mini" alignWithControl="true">
				<Label>Enable for 1PM, 1PM Mini, Plus Plug UK, Plus 2PM, Pro 4PM. Disable for Shelly 1 and 1 Mini.</Label>
			</Field>
			<Field id="sep3" type="separator"/>
			<Field id="addon_temp" type="checkbox" defaultValue="false">
				<Label>Has Temperature Add-on:</Label>
			</Field>
			<Field id="hlpAddon" type="label" fontSize="mini" alignWithControl="true">
				<Label>Enable if a Shelly Plus Add-on with DS18B20 probe is fitted. Reads probe 0 into addonTempC state.</Label>
			</Field>
			<Field id="sep4" type="separator"/>
			<Field id="lock_off" type="checkbox" defaultValue="false">
				<Label>Lock Off (power monitor only):</Label>
			</Field>
			<Field id="hlpLock" type="label" fontSize="mini" alignWithControl="true">
				<Label>Prevent this device being turned off. Turn On commands still work.</Label>
			</Field>
			<Field id="sep5" type="separator"/>
			<Field id="power_alert_enabled" type="checkbox" defaultValue="false">
				<Label>High Power Alert:</Label>
			</Field>
			<Field id="power_alert_watts" type="textfield" defaultValue="2000"
			       visibleBindingId="power_alert_enabled" visibleBindingValue="true">
				<Label>Alert Threshold (W):</Label>
			</Field>
			<Field id="hlpAlert" type="label" fontSize="mini" alignWithControl="true"
			       visibleBindingId="power_alert_enabled" visibleBindingValue="true">
				<Label>Fires highPowerAlert trigger and logs a warning when power exceeds this value.</Label>
			</Field>
			<Field id="sep6" type="separator"/>
			<Field id="mirror_to_variable" type="checkbox" defaultValue="false">
				<Label>Mirror States to Variables:</Label>
			</Field>
			<Field id="hlpMirror" type="label" fontSize="mini" alignWithControl="true">
				<Label>Write key states to Indigo variables in the ShellyDirect folder for use in control pages and scripts.</Label>
			</Field>
			<Field id="sep7" type="separator"/>
			<Field id="poll_interval" type="menu" defaultValue="30">
				<Label>Poll Interval:</Label>
				<List>
					<Option value="10">Every 10 seconds</Option>
					<Option value="30">Every 30 seconds (default)</Option>
					<Option value="60">Every 60 seconds</Option>
					<Option value="120">Every 2 minutes</Option>
				</List>
			</Field>
			<Field id="detail_interval" type="menu" defaultValue="300">
				<Label>Detail Sweep:</Label>
				<List>
					<Option value="0">Off</Option>
					<Option value="120">Every 2 minutes</Option>
					<Option value="300">Every 5 minutes (default)</Option>
					<Option value="900">Every 15 minutes</Option>
					<Option value="3600">Every hour</Option>
				</List>
			</Field>
			<Field id="detail_note" type="label" fontSize="small">
				<Label>Reads the device's own wifi signal, the AP it is associated with, its uptime and its cloud/MQTT links. Separate from the poll above because none of it changes second by second.</Label>
			</Field>
			<Field id="sep8" type="separator"/>
			<Field id="suppress_offline_alerts" type="checkbox" defaultValue="false">
				<Label>Suppress Offline Alerts:</Label>
			</Field>
			<Field id="hlpSuppress" type="label" fontSize="mini" alignWithControl="true">
				<Label>Do not log warnings or fire offline triggers when this device goes offline. Useful for appliance monitors that are intentionally unpowered when not in use.</Label>
			</Field>
			<Field id="sepWho" type="separator"/>
			<Field id="price_light" type="checkbox" defaultValue="false">
				<Label>Show Electricity Price on LED Ring:</Label>
			</Field>
			<Field id="hlpPrice" type="label" fontSize="mini" alignWithControl="true">
				<Label>Plugs with an LED ring only (Plus Plug UK, Plug S). The ring shows green at the cheap rate, amber at the standard rate and red at the peak rate - bright while the plug is on, dim while it is off. Set the price source in the plugin's Configure dialog. Untick to put the ring back as it was.</Label>
			</Field>
			<Field id="sepSafety" type="separator"/>
			<Field id="manage_switch_settings" type="checkbox" defaultValue="false">
				<Label>Manage Switch Settings from Indigo:</Label>
			</Field>
			<Field id="hlpManage" type="label" fontSize="mini" alignWithControl="true">
				<Label>The Shelly holds these settings itself, so they keep working when Indigo, the plugin or the network is down. Only what you set here is changed; the plugin checks them every six hours and puts them back if something else changed them.</Label>
			</Field>
			<Field id="auto_off_minutes" type="textfield" defaultValue=""
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>Turn Off After (minutes):</Label>
			</Field>
			<Field id="hlpAutoOff" type="label" fontSize="mini" alignWithControl="true"
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>The switch turns itself off this long after being turned on, however it was turned on. Blank or 0 for never.</Label>
			</Field>
			<Field id="power_limit_w" type="textfield" defaultValue=""
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>Cut Power Above (W):</Label>
			</Field>
			<Field id="current_limit_a" type="textfield" defaultValue=""
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>Cut Power Above (A):</Label>
			</Field>
			<Field id="hlpLimits" type="label" fontSize="mini" alignWithControl="true"
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>Blank leaves the device's own limit alone. A Plus Plug UK allows up to 3000 W and 13 A.</Label>
			</Field>
			<Field id="initial_state" type="menu" defaultValue=""
			       visibleBindingId="manage_switch_settings" visibleBindingValue="true">
				<Label>After a Power Cut:</Label>
				<List>
					<Option value="">Leave as set on the device</Option>
					<Option value="off">Stay off</Option>
					<Option value="on">Come on</Option>
					<Option value="restore_last">Go back to how it was</Option>
					<Option value="match_input">Follow its switch</Option>
				</List>
			</Field>
			<Field id="sepFw" type="separator"/>
			<Field id="hold_firmware" type="checkbox" defaultValue="false">
				<Label>Hold Firmware:</Label>
			</Field>
			<Field id="hlpHoldFw" type="label" fontSize="mini" alignWithControl="true">
				<Label>Never update this device's firmware from Indigo (the Update Firmware action and menu skip it).</Label>
			</Field>
		</ConfigUI>
		<States>
			<State id="powerWatts">
				<ValueType>Float</ValueType>
				<TriggerLabel>Power (W)</TriggerLabel>
				<ControlPageLabel>Power</ControlPageLabel>
			</State>
			<State id="voltage">
				<ValueType>Float</ValueType>
				<TriggerLabel>Voltage (V)</TriggerLabel>
				<ControlPageLabel>Voltage</ControlPageLabel>
			</State>
			<State id="currentAmps">
				<ValueType>Float</ValueType>
				<TriggerLabel>Current (A)</TriggerLabel>
				<ControlPageLabel>Current</ControlPageLabel>
			</State>
			<State id="energyKwhToday">
				<ValueType>Float</ValueType>
				<TriggerLabel>Energy Today (kWh)</TriggerLabel>
				<ControlPageLabel>Today kWh</ControlPageLabel>
			</State>
			<State id="energyKwhMonth">
				<ValueType>Float</ValueType>
				<TriggerLabel>Energy This Month (kWh)</TriggerLabel>
				<ControlPageLabel>Month kWh</ControlPageLabel>
			</State>

			<State id="deviceTempC">
				<ValueType>Float</ValueType>
				<TriggerLabel>Device Temperature (C)</TriggerLabel>
				<ControlPageLabel>Dev Temp</ControlPageLabel>
			</State>
			<State id="addonTempC">
				<ValueType>Float</ValueType>
				<TriggerLabel>Add-on Probe Temperature (C)</TriggerLabel>
				<ControlPageLabel>Probe Temp</ControlPageLabel>
			</State>
			<State id="lastChangedBy">
				<ValueType>String</ValueType>
				<TriggerLabel>Last Switched By</TriggerLabel>
				<ControlPageLabel>Switched By</ControlPageLabel>
			</State>
			<State id="deviceOnline">
				<ValueType>Boolean</ValueType>
				<TriggerLabel>Device Online</TriggerLabel>
				<ControlPageLabel>Online</ControlPageLabel>
			</State>
		</States>
	</Device>

